{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2p.nonnast.dev/schemas/3d/scene-expectation.schema.json",
  "title": "D2P Scene Expectation",
  "description": "Machine-readable expected structure of the scene built from one scene input (fixture use, design decision ADR-025 §5). It states what every conforming scene snapshot of that input must contain: coordinate system, scene unit and conversion, the panel and seam bindings, the control measures and anchor positions, and the expected bindingsDigest. Meshes are not expected results: mesh digests depend on the backend and profile (T3D-015) and meshes are compared with the pinned tolerance profile only (metric d2p:mesh-planar-deviation).",
  "type": "object",
  "properties": {
    "documentType": {
      "description": "Document type discriminator.",
      "const": "d2p:scene-expectation"
    },
    "schemaVersion": {
      "$ref": "https://d2p.nonnast.dev/schemas/core/ids.schema.json#/$defs/schemaVersion",
      "description": "Full SemVer of the standard release this document was written against."
    },
    "expectationId": {
      "$ref": "https://d2p.nonnast.dev/schemas/core/ids.schema.json#/$defs/sceneExpectationId",
      "description": "Own ID ('sxp_')."
    },
    "sceneInputRef": {
      "description": "The d2p:scene-input; 'digest' is required and equals its contentDigest.",
      "type": "object",
      "$ref": "https://d2p.nonnast.dev/schemas/core/artifact-ref.schema.json#/$defs/derivedRef",
      "properties": {
        "digest": true
      },
      "required": [
        "digest"
      ]
    },
    "garmentRef": {
      "$ref": "https://d2p.nonnast.dev/schemas/core/artifact-ref.schema.json#/$defs/artifactRef",
      "description": "Pinned garment revision."
    },
    "arrangementId": {
      "$ref": "https://d2p.nonnast.dev/schemas/core/ids.schema.json#/$defs/elementId",
      "description": "Arrangement built."
    },
    "mode": {
      "description": "Evaluation mode.",
      "$ref": "https://d2p.nonnast.dev/schemas/3d/scene-input.schema.json#/$defs/sceneMode"
    },
    "meshProfile": {
      "$ref": "https://d2p.nonnast.dev/schemas/core/ids.schema.json#/$defs/versionedId",
      "description": "Mesh profile of the scene input."
    },
    "toleranceProfile": {
      "$ref": "https://d2p.nonnast.dev/schemas/core/ids.schema.json#/$defs/versionedId",
      "description": "Tolerance profile meshes are compared with."
    },
    "coordinateSystem": {
      "description": "Expected scene coordinate system.",
      "$ref": "https://d2p.nonnast.dev/schemas/3d/garment.schema.json#/$defs/garmentCoordinateSystem"
    },
    "sceneUnit": {
      "description": "Expected scene unit.",
      "type": "string",
      "const": "m"
    },
    "unitConversion": {
      "description": "Expected unit conversion.",
      "type": "object",
      "const": {
        "from": "mm",
        "to": "m",
        "factor": 0.001
      }
    },
    "panelBindings": {
      "description": "Expected panel bindings, sorted by panelInstanceId.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://d2p.nonnast.dev/schemas/3d/scene-snapshot.schema.json#/$defs/panelBinding"
      }
    },
    "seamBindings": {
      "description": "Expected seam bindings, sorted by id.",
      "type": "array",
      "items": {
        "$ref": "https://d2p.nonnast.dev/schemas/3d/garment.schema.json#/$defs/sewingBinding"
      }
    },
    "controlMeasures": {
      "description": "Expected control measures, sorted by seamInterfaceId, then panelInstanceId.",
      "type": "array",
      "items": {
        "$ref": "https://d2p.nonnast.dev/schemas/3d/scene-snapshot.schema.json#/$defs/controlMeasure"
      }
    },
    "anchors": {
      "description": "Expected anchor positions, sorted by panelInstanceId, then contourId.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sceneAnchor"
      }
    },
    "bindingsDigest": {
      "$ref": "https://d2p.nonnast.dev/schemas/core/digest.schema.json#/$defs/digest",
      "description": "Expected bindingsDigest of a conforming scene snapshot of the input (catalog §1.8)."
    },
    "contentDigest": {
      "$ref": "https://d2p.nonnast.dev/schemas/core/digest.schema.json#/$defs/digest",
      "description": "Optional digest of this document (d2p-digest-v1, excluding contentDigest)."
    },
    "extensions": {
      "$ref": "https://d2p.nonnast.dev/schemas/core/extension.schema.json#/$defs/extensions",
      "description": "Optional extension blocks."
    }
  },
  "required": [
    "documentType",
    "schemaVersion",
    "expectationId",
    "sceneInputRef",
    "garmentRef",
    "arrangementId",
    "mode",
    "meshProfile",
    "toleranceProfile",
    "coordinateSystem",
    "sceneUnit",
    "unitConversion",
    "panelBindings",
    "seamBindings",
    "controlMeasures",
    "anchors",
    "bindingsDigest"
  ],
  "additionalProperties": false,
  "$defs": {
    "sceneAnchor": {
      "title": "Scene anchor",
      "description": "Expected scene position of the start point of a contour of a panel (the contour's 'start' in the geometry snapshot, transformed into the scene in m). Anchors check axis convention, mirroring and the mm to m conversion (GAR-017).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panelInstanceId",
        "contourId",
        "positionM"
      ],
      "properties": {
        "panelInstanceId": {
          "$ref": "https://d2p.nonnast.dev/schemas/core/ids.schema.json#/$defs/elementId",
          "description": "Panel instance."
        },
        "contourId": {
          "$ref": "https://d2p.nonnast.dev/schemas/core/ids.schema.json#/$defs/elementId",
          "description": "Contour of the panel's piece."
        },
        "positionM": {
          "description": "Expected scene position in m.",
          "$ref": "https://d2p.nonnast.dev/schemas/3d/garment.schema.json#/$defs/point3"
        }
      }
    }
  }
}
